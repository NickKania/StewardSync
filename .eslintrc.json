{
  "root": true,
  "ignorePatterns": [
    "dist/",
    "out-tsc/",
    ".angular/",
    "convex/_generated/",
    "node_modules/"
  ],
  "overrides": [
    {
      "files": ["*.ts"],
      "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:@angular-eslint/recommended"
      ],
      "plugins": ["@typescript-eslint", "@angular-eslint"],
      "rules": {
        "@angular-eslint/no-host-metadata-property": [
          "error",
          { "allowStatic": true }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "app",
            "style": "camelCase"
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "app",
            "style": "kebab-case"
          }
        ],
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/no-unused-vars": [
          "warn",
          { "argsIgnorePattern": "^_" }
        ]
      }
    },
    {
      "files": ["src/app/features/drivers/driver-list/driver-list.component.ts"],
      "rules": { "@angular-eslint/no-empty-lifecycle-method": "warn" }
    },
    {
      "files": [
        "src/app/features/reports/edit-decision/edit-decision.component.ts",
        "src/app/shared/components/modal/modal.component.ts"
      ],
      "rules": { "@angular-eslint/no-output-native": "warn" }
    },
    {
      "files": ["src/app/shared/components/button/button.component.ts"],
      "rules": { "@angular-eslint/no-output-on-prefix": "warn" }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@angular-eslint/template/recommended"],
      "rules": {}
    }
  ]
}
